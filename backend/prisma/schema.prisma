generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      News[]
  reviews   Review[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  country     String?
  image       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  perfumes    Perfume[]
}

model Perfumist {
  id        String    @id @default(uuid())
  name      String
  country   String?
  bio       String?
  photo     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  perfumes  Perfume[]
}

model Perfume {
  id          String     @id @default(uuid())
  name        String
  collection  String?
  gender      String
  price       Float      @default(0)
  image       String?
  year        Int?
  topNotes    String[]
  heartNotes  String[]
  baseNotes   String[]
  description String?
  brandId     String
  perfumistId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  perfumist   Perfumist? @relation(fields: [perfumistId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviews     Review[]
}

model Review {
  id          String   @id @default(uuid())
  rating      Int      @default(5)
  comment     String
  longevidade Int?
  rastro      Int?
  date        DateTime @default(now())
  perfumeId   String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  perfume     Perfume  @relation(fields: [perfumeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model News {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  content   String
  date      DateTime @default(now())
  image     String?
  autorId   String?  @map("autor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  autor     User?    @relation(fields: [autorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AromaticGroup {
  id                     String   @id @default(uuid())
  name                   String
  color                  String?
  gradient               String?
  textColor              String?
  icon                   String?
  gender                 String?
  description            String?
  seasonality            String[]
  characteristics        String[]
  subGroups              String[]
  representativePerfumes String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}
